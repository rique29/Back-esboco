# Copie este arquivo para ".env" e preencha. NUNCA publique o .env.

# Endereço do Supabase local visto de DENTRO do container Docker
SUPABASE_URL=http://host.docker.internal:54321

# Chave de serviço: npx supabase status -o env  (SERVICE_ROLE_KEY ou SECRET_KEY)
SUPABASE_SERVICE_KEY=

# Assina os tokens de login. Gere com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Chave AES-256 (64 caracteres hexadecimais). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se perder esta chave, os campos criptografados não podem mais ser lidos.
AES_KEY=

# Opcionais (valores padrão entre parênteses)
# PORT=3000
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=7d
# CORS_ORIGIN=*            (em produção: https://seu-front.com)
# RATE_LIMIT_AUTH=100      (requisições por 15 min por IP nas rotas /auth)
